{
  "name": "smae",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "db:migrate:gen": "./bin/db-migrate-gen",
    "db:migrate:up": "prisma migrate dev",
    "db:migrate:down": "./bin/db-migrate-down",
    "start:migrate:watch": "PGSQL_DIR=./prisma/manual-copy/ node dist/bin/pgsql-migrate.js --watch",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:prod:deploy": "prisma migrate deploy",
    "script:get-token": "node dist/src/bin/get-token.js",
    "organize-imports": "organize-imports-cli tsconfig.json",
    "duckdb:extensions": "node tools/install-duckdb-extensions.js",
    "postinstall": "node scripts/postinstall.js",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "run-api.sh",
    "build:emails": "mjml src/public/email-src/emails/*.mjml -o src/public/email-templates/ --config.allowIncludes=true --config.includePath=..",
    "build:emails:watch": "mjml --config.validationLevel=strict -w src/public/email-src/emails/*.mjml -o src/public/email-templates/ --config.allowIncludes=true --config.includePath=..",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "test:e2e:cov": "jest --config ./test/jest-e2e.json --coverage --forceExit",
    "test:e2e:ci": "jest --config ./test/jest-e2e.json --coverage --forceExit --ci --reporters=default --reporters=jest-junit",
    "check:modules": "ts-node tools/check-module-imports.ts",
    "docs:report-columns": "ts-node -T -r tsconfig-paths/register bin/report-columns-gen.ts",
    "spellcheck:ptbr": "ts-node -T bin/spellcheck-ptbr.ts"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.1",
    "@duckdb/node-api": "1.5.5-r.2",
    "@json2csv/node": "^7.0.7",
    "@json2csv/plainjs": "^7.0.7",
    "@json2csv/transforms": "^7.0.7",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@ts-graphviz/adapter": "^2.0.6",
    "@turf/simplify": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.1",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.12",
    "duckdb-report-builder": "^0.5.0",
    "ejs": "^6.0.1",
    "express-winston": "^4.2.0",
    "fast-json-stable-stringify": "^2.1.0",
    "geojson-validation": "^1.0.2",
    "got": "^11.8.5",
    "he": "^1.2.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "moment": "^2.30.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "percentile": "^1.6.0",
    "pg": "^8.22.0",
    "prisma-field-encryption": "https://pkg.pr.new/47ng/prisma-field-encryption@151",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "ts-graphviz": "^2.1.6",
    "uuidv7": "^0.6.3",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cron": "^2.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/geojson-validation": "^1.0.3",
    "@types/got": "^9.6.12",
    "@types/graphlib": "^2.1.12",
    "@types/he": "^1.2.3",
    "@types/jest": "30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/minio": "^7.1.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.2.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "30.4.2",
    "mjml": "^5.4.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.8.3",
    "yargs": "17.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
